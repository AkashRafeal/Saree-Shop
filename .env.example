# Environment Variables Template for SareeAura E-Commerce Platform
# Copy this file to .env and replace with your actual configuration
# NEVER commit the actual .env file to version control

# ===============================
# SERVER & APP CONFIGURATION
# ===============================
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===============================
# MYSQL DATABASE CONFIGURATION
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sareeaura_db
DB_USER=root
DB_PASSWORD=root

# ===============================
# SECURITY / JWT CONFIGURATION
# ===============================
# Ensure secret is at least 256 bits (32+ characters) for HMAC-SHA256
JWT_SECRET=SareeAuraSuperSecretLuxurySilkAndZariKey2026WithSufficientLengthHMACSHA256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===============================
# RAZORPAY PAYMENT GATEWAY (TEST MODE)
# ===============================
RAZORPAY_KEY_ID=rzp_test_sareeaura2026
RAZORPAY_KEY_SECRET=secret_sareeaura_test_key_2026

# ===============================
# CLOUDINARY IMAGE STORAGE
# ===============================
CLOUDINARY_CLOUD_NAME=sareeaura-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# ===============================
# MAIL NOTIFICATIONS (SMTP)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@sareeaura.com
MAIL_PASSWORD=your_app_password_here

# ===============================
# CORS & FRONTEND CLIENT
# ===============================
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
